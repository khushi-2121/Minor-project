## Backend: copy these values to server/.env
PORT=5000
NODE_ENV=production
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=
ML_SERVICE_URL=

## Frontend: copy this value to client/.env.local
VITE_API_URL=

## Optional server-side AI provider configuration
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_URL=https://api.openai.com/v1/chat/completions

## Not currently used by this repository
# SESSION_SECRET=
